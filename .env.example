# ---------------------------------------------------------------
# NotifyHub environment configuration
# Copy to .env.local for development. Never commit real secrets.
# ---------------------------------------------------------------

# Supabase project (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used for onboarding, inviting admins and OTP storage.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Root domain the platform is served from (no protocol).
#   production:  notifyhub.in
#   development: localhost:3000   (tenant portals at vits.localhost:3000)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# "true"  -> each college is served at <slug>.<root domain>
# "false" -> each college is served at <root domain>/s/<slug>
#            (useful on Vercel preview URLs where wildcard subdomains are unavailable)
NEXT_PUBLIC_USE_SUBDOMAINS=true
# http for local development, https everywhere else
NEXT_PUBLIC_PROTOCOL=http
# Share the admin session between notifyhub.in and *.notifyhub.in.
# Leave empty on localhost.  Production: .notifyhub.in
NEXT_PUBLIC_COOKIE_DOMAIN=

# Secret used to hash one-time verification codes (any long random string).
OTP_SECRET=replace-with-64-random-characters

# Email: verification codes, account confirmation, invitations, password resets.
# NotifyHub sends these itself (Supabase's built-in mailer allows only ~2 emails an hour).
# Set ONE of the two options. With neither, development prints emails to the terminal.
#
# Option A: SMTP, for example a Gmail account with an app password
# (Google Account > Security > 2-Step Verification > App passwords).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
#
# Option B: Resend (needs your own domain verified in Resend).
RESEND_API_KEY=
#
# Sender shown to recipients. Defaults to the SMTP_USER address.
EMAIL_FROM=

# Contact address shown on legal pages
NEXT_PUBLIC_SUPPORT_EMAIL=support@notifyhub.in
